# ============================================================================
# TACTICAL INTELLIGENCE LAB — configuração local (copie para .env e preencha)
# O .env NUNCA deve ir para o GitHub (já está no .gitignore).
# ============================================================================

# IA generativa (opcional). Sem chave, o app usa o redator local auditado.
# Chave gratuita: https://aistudio.google.com/
GEMINI_API_KEY=coloque_sua_chave_aqui

# API-Football (opcional) — boxscore oficial: estatísticas, escalações, notas, linha do tempo.
# Plano grátis: 100 requisições/dia; a temporada atual pode exigir plano pago.
# Cadastro: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=coloque_sua_chave_aqui

# football-data.org (opcional) — placares oficiais da temporada atual (12 competições, inclui Brasileirão).
# Token grátis: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=coloque_seu_token_aqui

# Feed JSON público da ESPN (NÃO oficial). Desativado por padrão.
# Só ative para uso pessoal/acadêmico e depois de ler os termos de uso da ESPN.
ENABLE_ESPN_PUBLIC_FEED=false

# Caminho do banco de dados SQLite local
DATABASE_PATH=database/tactical_lab.db

# Atualização automática da base enquanto o app está aberto (1 = ligada, 0 = desligada)
# e intervalo em horas para os jogos recentes. Com o app fechado: .\scripts\agendar_atualizacao.ps1
AUTO_SYNC=1
AUTO_SYNC_HOURS=3

# Modelo do Gemini (opcional). Se o padrão não existir para a sua chave, o app tenta outros sozinho.
# GEMINI_MODEL=gemini-2.5-flash

# ---- Fontes extras da base unificada (data/lake) ----
# Transfermarkt (transfermarkt-datasets) e Understat não precisam de chave.
# API-Futebol (futebol brasileiro): chave do painel de api-futebol.com.br
API_FUTEBOL_KEY=
# Base dos Dados (histórico do Brasileirão desde 2003, via BigQuery): ID de um projeto seu do Google Cloud
# e `pip install google-cloud-bigquery db-dtypes` (ou `pip install basedosdados`).
BASEDOSDADOS_BILLING_ID=
# Cópia local do StatsBomb Open Data (git clone --depth 1 https://github.com/statsbomb/open-data):
# STATSBOMB_OPEN_DATA_PATH=C:\dados\open-data
# Simonetti Stats (coleta local para pesquisa; ver docs/SIMONETTI.md)
# SIMONETTI_DATA_URLS=
# SIMONETTI_DELAY_S=3
# SIMONETTI_MAX_PAGES=40
